# Dhwani Environment Configuration Example
# Copy the missing keys into your local .env file (never commit .env to Git).

# Gnani Vachana STT & Timbre TTS API key
GNANI_API_KEY=your_gnani_api_key_here

# Google Gemini API key for AI Medical Report Extraction (ai_medical/model_client.py)
# GEMINI_API_KEY is also accepted as a fallback if LLM_API_KEY is unset.
LLM_API_KEY=your_google_gemini_api_key_here

# Valid Google Gemini model ID from Google AI Studio (e.g. gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash

# Optional request timeout in seconds (default: 60)
LLM_TIMEOUT=60
