# Dhwani Environment Configuration Example
# Copy the required keys into your local .env file (never commit .env to Git).

# Gnani Vachana STT & Timbre TTS API key
GNANI_API_KEY=your_gnani_api_key_here

# Google Gemini API key for AI Medical Report Extraction (ai_medical/model_client.py)
# GEMINI_API_KEY is also accepted as a fallback if LLM_API_KEY is unset.
LLM_API_KEY=your_google_gemini_api_key_here

# Valid Google Gemini model ID from Google AI Studio (e.g. gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash

# Optional request timeout in seconds (default: 60)
LLM_TIMEOUT=60

# Optional SQLite DB URL (Render temporary hackathon demo: sqlite:////tmp/dhwani_demo.db)
# DATABASE_URL=sqlite:////tmp/dhwani_demo.db

# Optional CORS origins for deployed Vercel HTTPS frontend
# CORS_ORIGINS=https://your-dhwani-app.vercel.app
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Frontend build environment variables (configure in Vercel Project Settings)
# VITE_PATIENT_API_URL=https://your-render-service.onrender.com
# VITE_VOICE_HTTP_URL=https://your-render-service.onrender.com
# VITE_VOICE_WS_URL=wss://your-render-service.onrender.com/ws/stt
